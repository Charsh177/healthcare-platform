# .env.example - Healthcare Platform Environment Configuration

# =============================================
# DATABASE CONFIGURATION
# =============================================
POSTGRES_DB=healthcare_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=healthcare_secure_password_123
DATABASE_URL=jdbc:postgresql://postgres:5432/healthcare_db

# =============================================
# JWT CONFIGURATION
# =============================================
JWT_SECRET=your-super-secret-key-min-32-characters-long-1234567890
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=2592000000

# =============================================
# SERVER CONFIGURATION
# =============================================
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=docker

# =============================================
# AUTH SERVICE
# =============================================
AUTH_SERVICE_PORT=8081
AUTH_SERVICE_URL=http://auth-service:8081

# =============================================
# PATIENT SERVICE
# =============================================
PATIENT_SERVICE_PORT=8082
PATIENT_SERVICE_URL=http://patient-service:8082

# =============================================
# CLAIMS SERVICE
# =============================================
CLAIMS_SERVICE_PORT=8083
CLAIMS_SERVICE_URL=http://claims-service:8083

# =============================================
# BILLING SERVICE
# =============================================
BILLING_SERVICE_PORT=8084
BILLING_SERVICE_URL=http://billing-service:8084

# =============================================
# FILE SERVICE
# =============================================
FILE_SERVICE_PORT=8085
FILE_SERVICE_URL=http://file-service:8085
FILE_UPLOAD_DIR=/app/files
FILE_MAX_SIZE=26214400
FILE_BATCH_MAX_SIZE=209715200

# =============================================
# LOGGING
# =============================================
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_HEALTHCARE=DEBUG
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK=INFO

# =============================================
# ACTUATOR (MONITORING)
# =============================================
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics

# =============================================
# DOCKER CONFIGURATION
# =============================================
DOCKER_BUILDKIT=1
COMPOSE_DOCKER_CLI_BUILD=1

# =============================================
# SECURITY
# =============================================
SECURITY_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
SECURITY_CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
SECURITY_CORS_ALLOWED_HEADERS=Content-Type,Authorization

# =============================================
# APPLICATION
# =============================================
APP_NAME=Healthcare Platform
APP_VERSION=1.0.0
APP_TIMEZONE=UTC

# =============================================
# EMAIL (Future)
# =============================================
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password
# MAIL_FROM=noreply@healthcare.local

# =============================================
# PAYMENT GATEWAY (Future)
# =============================================
# PAYMENT_GATEWAY_KEY=your-key
# PAYMENT_GATEWAY_SECRET=your-secret
# PAYMENT_GATEWAY_MODE=sandbox

# =============================================
# AWS/CLOUD (Future)
# =============================================
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=healthcare-files

# =============================================
# REDIS (Future - for caching)
# =============================================
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# =============================================
# KAFKA (Future - for events)
# =============================================
# KAFKA_BOOTSTRAP_SERVERS=kafka:9092
# KAFKA_TOPIC_PREFIX=healthcare

# Notes:
# 1. Create .env file from this template
# 2. Update values for your environment
# 3. Never commit .env file to version control
# 4. Use strong, unique passwords in production
# 5. Rotate secrets regularly
